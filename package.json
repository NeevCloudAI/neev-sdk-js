{
  "name": "@neevcloud/sdk",
  "version": "0.9.0",
  "description": "Official NeevCloud SDK for the Neev platform — Node, Bun, Deno & edge. First up: agent sandboxes.",
  "license": "Apache-2.0",
  "author": "NeevCloud",
  "homepage": "https://github.com/NeevCloudAI/neev-sdk-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeevCloudAI/neev-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/NeevCloudAI/neev-sdk-js/issues"
  },
  "keywords": ["neev", "neevcloud", "sdk", "agent", "sandbox", "ai", "gpu"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "agent-tools": ["./dist/agent-tools.d.ts"],
      "agent-tools/claude": ["./dist/agent-tools/claude.d.ts"],
      "agent-tools/openai-agents": ["./dist/agent-tools/openai-agents.d.ts"],
      "agent-tools/ai-sdk": ["./dist/agent-tools/ai-sdk.d.ts"]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent-tools": {
      "import": {
        "types": "./dist/agent-tools.d.ts",
        "default": "./dist/agent-tools.js"
      },
      "require": {
        "types": "./dist/agent-tools.d.cts",
        "default": "./dist/agent-tools.cjs"
      }
    },
    "./agent-tools/claude": {
      "import": {
        "types": "./dist/agent-tools/claude.d.ts",
        "default": "./dist/agent-tools/claude.js"
      },
      "require": {
        "types": "./dist/agent-tools/claude.d.cts",
        "default": "./dist/agent-tools/claude.cjs"
      }
    },
    "./agent-tools/openai-agents": {
      "import": {
        "types": "./dist/agent-tools/openai-agents.d.ts",
        "default": "./dist/agent-tools/openai-agents.js"
      },
      "require": {
        "types": "./dist/agent-tools/openai-agents.d.cts",
        "default": "./dist/agent-tools/openai-agents.cjs"
      }
    },
    "./agent-tools/ai-sdk": {
      "import": {
        "types": "./dist/agent-tools/ai-sdk.d.ts",
        "default": "./dist/agent-tools/ai-sdk.js"
      },
      "require": {
        "types": "./dist/agent-tools/ai-sdk.d.cts",
        "default": "./dist/agent-tools/ai-sdk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:publish": "pnpm build && node scripts/publish.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.20.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "ai": "^5.0.0",
    "openapi-typescript": "^7.4.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "zod": "^4.2.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@openai/agents": "^0.20.0",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "ws": "^8",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
